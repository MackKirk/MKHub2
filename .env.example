# =============================================================================
# MK Hub - VariÃ¡veis de Ambiente para Desenvolvimento Local
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessÃ¡rio
# O arquivo .env nÃ£o deve ser commitado (jÃ¡ estÃ¡ no .gitignore)

# =============================================================================
# DATABASE - Banco de Dados
# =============================================================================
# OpÃ§Ã£o 1: SQLite local (padrÃ£o para desenvolvimento isolado)
# DATABASE_URL=sqlite:///./var/dev.db

# Opção 2: PostgreSQL do Render (URL EXTERNA - para desenvolvimento local)
# Use esta URL quando quiser conectar ao banco do Render de sua máquina local.
# Obtenha a connection string no painel do Render (Database > Connection) e coloque abaixo.
# NUNCA commite a URL com senha no repositório. Veja SECRETS.example.md.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Opção 3: PostgreSQL do Render (URL INTERNA - apenas para referência)
# Esta URL sÃ³ funciona dentro da rede do Render (mais rÃ¡pida e segura)
# Use apenas em produÃ§Ã£o no Render, nÃ£o funciona localmente
# DATABASE_URL=postgresql+psycopg2://user:pass@internal-hostname:5432/dbname

AUTO_CREATE_DB=true

# =============================================================================
# SERVER - ConfiguraÃ§Ãµes do Servidor
# =============================================================================
PUBLIC_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# =============================================================================
# JWT - AutenticaÃ§Ã£o
# =============================================================================
# Gere um secret seguro para desenvolvimento local
# No Render, isso Ã© gerado automaticamente
JWT_SECRET=change-me-in-local-development
JWT_TTL=43200
REFRESH_TTL=1209600

# =============================================================================
# STORAGE - Armazenamento de Arquivos
# =============================================================================
# OpÃ§Ã£o: lob (Azure Blob Storage) ou hybrid (local + blob)
STORAGE_PROVIDER=blob

# Azure Blob Storage (opcional para desenvolvimento local)
# AZURE_BLOB_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_BLOB_CONTAINER=mkhub-files

# =============================================================================
# SMTP - Email
# =============================================================================
# ConfiguraÃ§Ãµes de email (opcional para desenvolvimento local)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_TLS=true
# MAIL_FROM=noreply@mackkirk.com

# Google Maps / Places (address autocomplete, geocoding, Map View)
# GOOGLE_PLACES_API_KEY=your-server-key
# VITE_GOOGLE_MAPS_API_KEY=your-browser-key
# Microsoft Graph (opcional)
# GRAPH_APP_CLIENT_ID=your-client-id
# GRAPH_APP_TENANT_ID=your-tenant-id
# GRAPH_APP_CLIENT_SECRET=your-client-secret

# Dataforma (opcional)
# DATAFORMA_API_KEY=your-api-key
# DATAFORMA_SERVICE_CODE=your-service-code

# BambooHR (opcional)
# BAMBOOHR_SUBDOMAIN=your-subdomain
# BAMBOOHR_API_KEY=your-api-key

# =============================================================================
# FEATURE FLAGS - Flags de Funcionalidades
# =============================================================================
FEATURE_FLAGS={}

# =============================================================================
# RATE LIMIT - Limite de RequisiÃ§Ãµes
# =============================================================================
# Formato: 
Ãºmero/unidade (ex: 100/minute, 1000/hour)
RATE_LIMIT=100/minute

# Em produÃ§Ã£o, defina origens permitidas (CORS). Ex: https://mkhub2.onrender.com
# ALLOWED_ORIGINS=*

# Tamanho mÃ¡ximo de upload em MB (padrÃ£o 50)
# UPLOAD_MAX_MB=50

# =============================================================================
# TIMEZONE
# =============================================================================
TZ_DEFAULT=America/Vancouver
